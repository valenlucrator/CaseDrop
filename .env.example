# Local dev only. Copy to .env.local — never commit real values.

# Shortens the judging window so you can walk the whole loop in one sitting.
# Ignored in production builds: JUDGING_DELAY_MS falls back to 3h whenever
# import.meta.env.DEV is false, so a tester build can never ship at 20s.
VITE_JUDGING_DELAY_MS=20000

# Phase B — only needed once FEATURES.cloudSync is turned on.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
